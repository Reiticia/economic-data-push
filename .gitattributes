# Line-ending policy
#
# The repository stores text with LF and checks it out with LF, so a Windows
# editor or tool that writes CRLF no longer produces whole-file diffs.
# Windows launchers are the exception and stay CRLF; binaries are never touched.
#
# Start from git's own text detection, defaulting to LF.
* text=auto eol=lf

# Source and configuration: always LF.
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.pro text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows launchers must keep CRLF for cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries: never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.apk binary
*.aab binary
*.jar binary
*.keystore binary
*.jks binary
*.zip binary
*.db binary
*.so binary
*.dex binary
